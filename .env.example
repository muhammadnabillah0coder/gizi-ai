# Salin file ini menjadi .env dan isi dengan API Key asli Anda
# Dapatkan API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Opsional: Port server aplikasi
PORT=8501

# Opsional: Database Cloud Permanen Supabase PostgreSQL (Session Pooler IPv4 URI)
# Jika kosong, aplikasi berjalan normal memakai SQLite lokal (tkpi_nutrition.db).
# DATABASE_URL=postgresql://postgres.<project_ref>:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Opsional: Secret penandatanganan tautan sesi (?u=...&s=...)
# SESSION_SECRET=ganti_dengan_string_acak_panjang

# Opsional: Webhook Notifikasi Error ke HP (Layer 7: Monitoring)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsional: Paket Pro & Pembayaran QRIS (pilih salah satu: Mayar.id / Midtrans / Manual WA)
# 1) Mayar.id (paling mudah untuk perorangan / KTP Indonesia)
# MAYAR_API_KEY=
# MAYAR_WEBHOOK_TOKEN=
# MAYAR_IS_SANDBOX=false
# Atau gunakan tautan statis Mayar tanpa API Key:
# MAYAR_CHECKOUT_URL_7D=
# MAYAR_CHECKOUT_URL_30D=
# MAYAR_CHECKOUT_URL_365D=

# 2) Midtrans Snap / QRIS
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_SANDBOX=true

# 3) Fallback konfirmasi manual QRIS via WhatsApp Admin (format 628xxxxxxxxxx)
# PRO_ADMIN_WA=
# APP_PUBLIC_URL=https://nutrisi-cerdas.streamlit.app
